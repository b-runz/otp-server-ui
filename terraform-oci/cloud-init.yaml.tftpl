#cloud-config
package_update: true
packages:
  - ca-certificates
  - curl
  - gnupg
  - iptables-persistent

write_files:
  - path: /etc/caddy/Caddyfile
    content: |
      ${indent(6, caddyfile_content)}

  - path: /usr/local/bin/otp-graph-refresh.sh
    permissions: '0755'
    content: |
      ${indent(6, refresh_script_content)}

  - path: /etc/cron.d/otp-graph-refresh
    content: |
      0 3 * * 1 ubuntu TZ=Europe/Copenhagen /usr/local/bin/otp-graph-refresh.sh >> /var/log/otp-graph-refresh.log 2>&1

runcmd:
  - curl -fsSL https://get.docker.com | sh
  - usermod -aG docker ubuntu

  # xcaddy build: Caddy + caddy-ratelimit, compiled once at first boot.
  #
  # Installs a current official Go release directly rather than apt's
  # `golang-go` package -- confirmed directly against a real deploy that
  # Ubuntu 22.04's `golang-go` is Go 1.18 (from 2022), which can't even
  # PARSE xcaddy's go.mod ("unknown directive: toolchain"; the toolchain
  # directive itself didn't exist before Go 1.21). Ubuntu's LTS apt repos
  # don't backport newer Go majors, so this isn't a transient packaging
  # gap -- apt's golang-go was never going to work here. The go.dev JSON
  # API is queried for the current stable linux/arm64 release instead of
  # hardcoding a version that will eventually go stale.
  #
  # GOPATH is exported explicitly rather than resolved via `$(go env
  # GOPATH)` -- confirmed directly that `go env GOPATH` comes back EMPTY
  # in cloud-init's non-interactive runcmd execution context (collapsing
  # "$GOPATH/bin/xcaddy" into the literal, nonexistent path
  # "/bin/xcaddy"), even though the same command works fine in an
  # interactive shell. Every step here shares one GOPATH/PATH, so it's
  # all one multi-line block -- runcmd's separate list items are each
  # their own shell invocation and don't share exported variables.
  - |
    GO_TARBALL=$(curl -fsSL 'https://go.dev/dl/?mode=json' | grep -o 'go[0-9.]*\.linux-arm64\.tar\.gz' | head -1)
    curl -fsSL -o /tmp/go.tar.gz "https://go.dev/dl/$GO_TARBALL"
    rm -rf /usr/local/go
    tar -C /usr/local -xzf /tmp/go.tar.gz
    export PATH="/usr/local/go/bin:$PATH"
    export GOPATH=/root/go
    go install github.com/caddyserver/xcaddy/cmd/xcaddy@latest
    "$GOPATH/bin/xcaddy" build --with github.com/mholt/caddy-ratelimit --output /usr/bin/caddy

  - id caddy >/dev/null 2>&1 || groupadd --system caddy
  - id caddy >/dev/null 2>&1 || useradd --system --gid caddy --home-dir /var/lib/caddy --no-create-home --shell /usr/sbin/nologin --comment 'Caddy web server' caddy
  - mkdir -p /var/lib/caddy /var/log/caddy
  - chown -R caddy:caddy /var/lib/caddy /var/log/caddy

  - |
    cat > /etc/systemd/system/caddy.service <<'EOF'
    [Unit]
    Description=Caddy
    After=network.target

    [Service]
    User=caddy
    Group=caddy
    # Caddy binds ports 80/443 (both < 1024); the unprivileged caddy user
    # can't do that on its own -- confirmed directly against a real deploy
    # ("listen tcp :443: bind: permission denied"). These two directives
    # are systemd's standard way to grant just that one capability without
    # running Caddy as root (the same pattern Caddy's own official
    # systemd unit file uses upstream).
    AmbientCapabilities=CAP_NET_BIND_SERVICE
    CapabilityBoundingSet=CAP_NET_BIND_SERVICE
    ExecStart=/usr/bin/caddy run --environ --config /etc/caddy/Caddyfile
    ExecReload=/usr/bin/caddy reload --config /etc/caddy/Caddyfile
    Restart=on-failure

    [Install]
    WantedBy=multi-user.target
    EOF

  - systemctl daemon-reload
  - systemctl enable caddy
  - systemctl restart caddy

  - mkdir -p /home/ubuntu/otp-graph
  - chown ubuntu:ubuntu /home/ubuntu/otp-graph

  - iptables -I INPUT -p tcp --dport 80 -j ACCEPT
  - iptables -I INPUT -p tcp --dport 443 -j ACCEPT
  - netfilter-persistent save
